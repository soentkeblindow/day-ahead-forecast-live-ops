# Copy this file to .env and fill in real values. .env is gitignored; this
# file is not -- never put real keys here.

# ENTSO-E Transparency Platform API token (Account Settings -> Web Api
# Security Token). Used by the model pipeline and by the availability audit.
ENTSOE_API_KEY=

# Energy Arena API key (from your Arena account). Used by arena/catalog.py,
# arena/submit.py, and the availability audit's daily challenge-catalog
# snapshot.
ARENA_API_KEY=

# Energy Arena API base URL, e.g. https://api.energy-arena.org (no trailing
# slash). Not a secret, but kept alongside the keys since arena/catalog.py
# reads all three from the environment the same way.
ARENA_API_BASE_URL=
